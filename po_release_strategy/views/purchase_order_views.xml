<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_po_release" model="ir.ui.view">
        <field name="name">purchase.order.form.po.release</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Native confirm buttons are replaced by "Submit for Approval" while not released -->
            <xpath expr="//header/button[@id='bid_confirm']" position="attributes">
                <attribute name="invisible">state != 'sent' or (release_required and release_state != 'approved')</attribute>
            </xpath>
            <xpath expr="//header/button[@id='draft_confirm']" position="attributes">
                <attribute name="invisible">state != 'draft' or (release_required and release_state != 'approved')</attribute>
            </xpath>
            <xpath expr="//header/button[@name='button_approve']" position="attributes">
                <attribute name="invisible">state != 'to approve' or release_required</attribute>
            </xpath>
            <xpath expr="//header/button[@id='bid_confirm']" position="before">
                <field name="release_required" invisible="1"/>
                <field name="release_state" invisible="1"/>
                <field name="release_can_approve" invisible="1"/>
                <field name="release_can_reset" invisible="1"/>
                <button name="action_release_submit" type="object" string="Submit for Approval"
                        class="oe_highlight" data-hotkey="v"
                        invisible="not release_required or state not in ('draft', 'sent') or release_state not in ('draft', 'rejected')"/>
                <button name="action_release_approve" type="object" string="Approve"
                        class="oe_highlight" data-hotkey="z"
                        invisible="not release_can_approve"/>
                <button name="action_release_reject" type="object" string="Reject"
                        invisible="not release_can_approve"/>
                <button name="action_release_bypass" type="object" string="Bypass Approval"
                        groups="po_release_strategy.group_po_release_supervisor"
                        invisible="not release_required or release_state != 'pending'"/>
                <button name="action_release_reset" type="object" string="Reset Release"
                        invisible="not release_can_reset"/>
            </xpath>

            <!-- Status banners -->
            <xpath expr="//sheet/div[@name='button_box']" position="after">
                <div class="alert alert-warning o_po_release_alert" role="alert"
                     invisible="not release_required or release_state != 'pending'">
                    <i class="fa fa-hourglass-half" role="img" aria-label="Waiting" title="Waiting"/>
                    <span>Waiting for release approval by:</span>
                    <field name="release_pending_user_ids" widget="many2many_tags" readonly="1" class="o_po_release_inline"/>
                </div>
                <div class="alert alert-success o_po_release_alert" role="alert"
                     invisible="not release_required or release_state != 'approved' or state not in ('draft', 'sent')">
                    <i class="fa fa-check" role="img" aria-label="Released" title="Released"/>
                    <span>This order is released and ready to be confirmed.</span>
                </div>
                <div class="alert alert-danger o_po_release_alert" role="alert"
                     invisible="not release_required or release_state != 'rejected'">
                    <i class="fa fa-times" role="img" aria-label="Rejected" title="Rejected"/>
                    <span>The release was rejected. Update the order and submit it again.</span>
                </div>
            </xpath>

            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="release_strategy_id" options="{'no_create': True}"
                       invisible="not release_required"
                       required="release_required and state in ('draft', 'sent')"
                       readonly="release_state in ('pending', 'approved')"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Release Strategy" name="release_strategy"
                      invisible="not release_required and not release_line_ids">
                    <group>
                        <group>
                            <field name="release_state" widget="badge"
                                   decoration-info="release_state == 'draft'"
                                   decoration-warning="release_state == 'pending'"
                                   decoration-success="release_state == 'approved'"
                                   decoration-danger="release_state == 'rejected'"/>
                            <field name="release_currency_id" invisible="1"/>
                            <field name="release_amount_company"/>
                            <field name="release_reset_count" invisible="release_reset_count == 0"/>
                        </group>
                        <group>
                            <field name="release_submit_date"/>
                            <field name="release_approval_date"/>
                            <field name="release_bypassed" invisible="not release_bypassed"/>
                            <field name="release_bypass_user_id" invisible="not release_bypassed"/>
                            <field name="release_bypass_reason" invisible="not release_bypassed"/>
                        </group>
                    </group>
                    <field name="release_line_ids" readonly="1">
                        <list decoration-muted="state in ('waiting', 'cancelled')"
                              decoration-warning="state == 'pending'"
                              decoration-success="state in ('approved', 'bypassed')"
                              decoration-danger="state == 'rejected'">
                            <field name="sequence" string="Stage"/>
                            <field name="role"/>
                            <field name="approver_type" optional="hide"/>
                            <field name="approver_display"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="min_amount" optional="hide"/>
                            <field name="max_amount" optional="hide"/>
                            <field name="state" widget="badge"
                                   decoration-warning="state == 'pending'"
                                   decoration-success="state in ('approved', 'bypassed')"
                                   decoration-danger="state == 'rejected'"/>
                            <field name="assigned_date"/>
                            <field name="approval_date"/>
                            <field name="approved_by_id" widget="many2one_avatar_user"/>
                            <field name="rejected_by_id" optional="hide" widget="many2one_avatar_user"/>
                            <field name="notes"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- RFQ list -->
    <record id="purchase_order_kpis_tree_po_release" model="ir.ui.view">
        <field name="name">purchase.order.kpis.tree.po.release</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="release_state" optional="show" widget="badge"
                       decoration-info="release_state == 'draft'"
                       decoration-warning="release_state == 'pending'"
                       decoration-success="release_state == 'approved'"
                       decoration-danger="release_state == 'rejected'"/>
            </xpath>
        </field>
    </record>

    <!-- Purchase order list -->
    <record id="purchase_order_view_tree_po_release" model="ir.ui.view">
        <field name="name">purchase.order.view.tree.po.release</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_status']" position="before">
                <field name="release_state" optional="hide" widget="badge"
                       decoration-warning="release_state == 'pending'"
                       decoration-success="release_state == 'approved'"
                       decoration-danger="release_state == 'rejected'"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_filter_po_release" model="ir.ui.view">
        <field name="name">purchase.order.filter.po.release</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='to_approve']" position="after">
                <separator/>
                <filter name="my_release_approvals" string="My Release Approvals"
                        domain="[('activity_ids.user_id', '=', uid), ('activity_ids.po_release_line_id', '!=', False)]"/>
                <filter name="release_pending" string="Waiting Release" domain="[('release_state', '=', 'pending')]"/>
                <filter name="release_approved" string="Released" domain="[('release_state', '=', 'approved')]"/>
                <filter name="release_rejected" string="Release Rejected" domain="[('release_state', '=', 'rejected')]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter name="group_release_state" string="Release Status" context="{'group_by': 'release_state'}"/>
                <filter name="group_release_strategy" string="Release Strategy" context="{'group_by': 'release_strategy_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_view_search_po_release" model="ir.ui.view">
        <field name="name">purchase.order.search.po.release</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='invoiced']" position="after">
                <separator/>
                <filter name="my_release_approvals" string="My Release Approvals"
                        domain="[('activity_ids.user_id', '=', uid), ('activity_ids.po_release_line_id', '!=', False)]"/>
                <filter name="release_pending" string="Waiting Release" domain="[('release_state', '=', 'pending')]"/>
            </xpath>
        </field>
    </record>

    <record id="action_po_release_my_approvals" model="ir.actions.act_window">
        <field name="name">Release Approvals</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form,kanban,activity</field>
        <field name="view_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="search_view_id" ref="purchase.view_purchase_order_filter"/>
        <field name="domain">[('release_state', '=', 'pending')]</field>
        <field name="context">{'search_default_my_release_approvals': 1, 'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No purchase order is waiting for your approval</p>
            <p>Orders waiting for your release approval will appear here.</p>
        </field>
    </record>
</odoo>
