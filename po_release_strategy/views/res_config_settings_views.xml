<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_po_release" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.po.release</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='po_order_approval']" position="after">
                <setting id="po_release_strategy" company_dependent="1"
                         help="Require a multi-level release strategy before purchase orders are confirmed">
                    <field name="po_release_strategy_enabled"/>
                    <div class="content-group" invisible="not po_release_strategy_enabled">
                        <div class="row mt16">
                            <label for="po_release_default_strategy_id" class="col-lg-4 o_light_label"/>
                            <field name="po_release_default_strategy_id" options="{'no_create': True}"/>
                        </div>
                        <div class="text-muted mt8">
                            Replaces the native purchase order approval for this company.
                        </div>
                        <div class="mt8">
                            <button name="%(po_release_strategy.action_po_release_strategy)d" type="action"
                                    string="Release Strategies" icon="oi-arrow-right" class="btn-link"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
