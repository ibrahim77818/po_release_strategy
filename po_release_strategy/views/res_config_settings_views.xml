<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_po_release" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.po.release</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='po_order_approval']" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="po_release_strategy">
                    <div class="o_setting_left_pane">
                        <field name="po_release_strategy_enabled"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="po_release_strategy_enabled"/>
                        <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." groups="base.group_multi_company"/>
                        <div class="text-muted">
                            Require a multi-level release strategy before purchase orders are confirmed
                        </div>
                        <div class="content-group" attrs="{'invisible': [('po_release_strategy_enabled', '=', False)]}">
                            <div class="row mt16">
                                <label for="po_release_default_strategy_id" class="col-lg-4 o_light_label"/>
                                <field name="po_release_default_strategy_id" options="{'no_create': True}"/>
                            </div>
                            <div class="text-muted mt8">
                                Replaces the native purchase order approval for this company.
                            </div>
                            <div class="mt8">
                                <button name="%(po_release_strategy.action_po_release_strategy)d" type="action"
                                        string="Release Strategies" icon="fa-arrow-right" class="btn-link"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
