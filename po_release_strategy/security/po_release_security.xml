<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- v19: access levels are grouped by res.groups.privilege (replaces group categories) -->
    <record id="res_groups_privilege_po_release" model="res.groups.privilege">
        <field name="name">Purchase Release Strategy</field>
        <field name="sequence">9</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_po_release_supervisor" model="res.groups">
        <field name="name">Release Supervisor</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_po_release"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Can bypass and reset purchase order release strategies.</field>
    </record>

    <data noupdate="1">
        <record id="po_release_strategy_company_rule" model="ir.rule">
            <field name="name">Release strategy: multi-company</field>
            <field name="model_id" ref="model_po_release_strategy"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="po_release_strategy_rule_company_rule" model="ir.rule">
            <field name="name">Release strategy rule: multi-company</field>
            <field name="model_id" ref="model_po_release_strategy_rule"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="po_release_line_company_rule" model="ir.rule">
            <field name="name">Release approval: multi-company</field>
            <field name="model_id" ref="model_purchase_order_release_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
